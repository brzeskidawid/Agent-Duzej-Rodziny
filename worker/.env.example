# --- Supabase (Project Settings → API). UWAGA: service_role, NIE anon. Nigdy nie wklejaj tego klucza do aplikacji webowej.
SUPABASE_URL=https://TWOJ-PROJEKT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Które źródła uruchamiać (po przecinku): demo, librus, 4parents
SOURCES=demo
INTERVAL_MINUTES=15
LOG_LEVEL=INFO

# demo: imię dziecka w aplikacji, do którego przypiąć testowe wpisy (może być puste)
DEMO_CHILD=

# Librus Synergia (konto rodzica)
LIBRUS_LOGIN=
LIBRUS_PASSWORD=
LIBRUS_CHILD=

# 4Parents (konto rodzica - ten sam e-mail i haslo co w aplikacji)
FOURPARENTS_URL=https://przedszkolemsf.4parents.pl
FOURPARENTS_LOGIN=
FOURPARENTS_PASSWORD=
# mapowanie: imie w 4Parents = imie w aplikacji (srednik miedzy wpisami)
FOURPARENTS_CHILD_MAP=Jan=Janek
